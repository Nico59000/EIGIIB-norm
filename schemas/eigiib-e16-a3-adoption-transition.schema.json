{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/eigiib-e16-a3-adoption-transition.schema.json",
  "title": "EIGIIB E16-A3 adoption transition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard",
    "status",
    "source",
    "target",
    "historical_preservation",
    "reserved_for_later_slices"
  ],
  "properties": {
    "standard": {
      "const": "EIGIIB-E16-A3-TRANSITION-1.0"
    },
    "status": {
      "const": "adopted-e16-a3"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice",
        "head_commit",
        "profile_revision",
        "authority_freeze"
      ],
      "properties": {
        "slice": {
          "const": "E16-A2"
        },
        "head_commit": {
          "const": "1bd5929a5a4415df8758b220765925ac80a797bc"
        },
        "profile_revision": {
          "const": "EIGIIB-E16-draft-1.0"
        },
        "authority_freeze": {
          "const": "conformance/e16-a2-authority-freeze.json"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extension",
        "slice",
        "profile_revision",
        "authority_manifest",
        "registry"
      ],
      "properties": {
        "extension": {
          "const": "E16-1.0"
        },
        "slice": {
          "const": "E16-A3"
        },
        "profile_revision": {
          "const": "EIGIIB-E16-draft-1.0"
        },
        "authority_manifest": {
          "const": "conformance/e16-a3-authority-manifest.json"
        },
        "registry": {
          "const": "conformance/retention-readback-restore.json"
        }
      }
    },
    "historical_preservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "e16_a2_claims_rewritten",
        "e16_a2_source_freeze_mutated",
        "transition_is_additive",
        "descendant_authority_frozen_separately"
      ],
      "properties": {
        "e16_a2_claims_rewritten": {
          "const": false
        },
        "e16_a2_source_freeze_mutated": {
          "const": false
        },
        "transition_is_additive": {
          "const": true
        },
        "descendant_authority_frozen_separately": {
          "const": true
        }
      }
    },
    "reserved_for_later_slices": {
      "const": [
        "custodian-succession",
        "replica-migration",
        "loss-and-quarantine",
        "anti-rollback-recovery",
        "independent-final-verifier-matrix",
        "differential-restore-replay"
      ]
    }
  }
}
