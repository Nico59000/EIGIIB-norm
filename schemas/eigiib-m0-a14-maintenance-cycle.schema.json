{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M0-A14 maintenance cycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "maintenanceEventId",
    "maintenanceClass",
    "predecessorRefreezeDigest",
    "successorRefreezeDigest",
    "requestDigest",
    "reopeningAuthorityDigest",
    "issuedAt",
    "expiresAt",
    "executedAt",
    "closedAt",
    "affectedPaths",
    "implementedPaths",
    "approvals",
    "governanceSnapshot",
    "governanceTransition",
    "revocationEvents",
    "authorizedWrites",
    "supersessionRecordValid",
    "independentVerificationValid",
    "workflowConclusions",
    "refreezeManifestValid",
    "independentRefreezeReadbackValid",
    "closureCertificateValid"
  ],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "maintenanceEventId": {
      "type": "string",
      "minLength": 1
    },
    "maintenanceClass": {
      "enum": [
        "normative-correction",
        "security-emergency",
        "deprecation-or-withdrawal"
      ]
    },
    "predecessorRefreezeDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "successorRefreezeDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reopeningAuthorityDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "executedAt": {
      "type": "string",
      "format": "date-time"
    },
    "closedAt": {
      "type": "string",
      "format": "date-time"
    },
    "affectedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "implementedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "collegeId",
          "approverId",
          "controlDomainId",
          "recordDigest"
        ],
        "properties": {
          "collegeId": {
            "enum": [
              "normative-authority-college",
              "operational-governance-college",
              "independent-verification-college"
            ]
          },
          "approverId": {
            "type": "string",
            "minLength": 1
          },
          "controlDomainId": {
            "type": "string",
            "minLength": 1
          },
          "recordDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "governanceSnapshot": {
      "$ref": "eigiib-m0-a14-governance-snapshot.schema.json"
    },
    "governanceTransition": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "eigiib-m0-a14-governance-transition.schema.json"
        }
      ]
    },
    "revocationEvents": {
      "type": "array",
      "items": {
        "$ref": "eigiib-m0-a14-revocation-event.schema.json"
      }
    },
    "authorizedWrites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "at"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "supersessionRecordValid": {
      "const": true
    },
    "independentVerificationValid": {
      "const": true
    },
    "workflowConclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "const": "success"
      }
    },
    "refreezeManifestValid": {
      "const": true
    },
    "independentRefreezeReadbackValid": {
      "const": true
    },
    "closureCertificateValid": {
      "const": true
    }
  }
}
