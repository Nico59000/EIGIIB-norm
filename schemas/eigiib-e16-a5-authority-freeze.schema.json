{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/e16-a5-authority-freeze.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard",
    "status",
    "profile_revision",
    "source_e16_a4_commit",
    "authority_count",
    "authorities"
  ],
  "properties": {
    "standard": {
      "const": "EIGIIB-E16-A5-FREEZE-1.0"
    },
    "status": {
      "const": "final-frozen"
    },
    "profile_revision": {
      "const": "EIGIIB-E16-1.0"
    },
    "source_e16_a4_commit": {
      "const": "b28fe74f829141232770155724620617bfb1241c"
    },
    "authority_count": {
      "const": 95
    },
    "authorities": {
      "type": "array",
      "minItems": 95,
      "maxItems": 95,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
