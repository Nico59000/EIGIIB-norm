{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schema/eigiib-m0-a3-interop-profiles.schema.json",
  "title": "EIGIIB M0-A3 External Interoperability Profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["standard", "revision", "as_of", "external_specs", "profiles"],
  "properties": {
    "standard": {"const": "EIGIIB-M0-A3-1.0"},
    "revision": {"type": "string", "minLength": 1},
    "as_of": {"type": "string", "format": "date"},
    "external_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "status", "domain", "canonical_uri", "reference_mode", "observed_on"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "status": {"enum": ["approved", "stable", "released", "draft"]},
          "domain": {"enum": ["attestation", "supply-chain-security", "bom", "transparency", "signature", "update-security", "workload-identity", "policy-engine", "time"]},
          "canonical_uri": {"type": "string", "pattern": "^https://"},
          "reference_mode": {"enum": ["versioned-reference", "exact-draft", "moving-reference"]},
          "observed_on": {"type": "string", "format": "date"}
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision", "state", "external_spec", "direction", "eigiib_authorities", "mappings", "does_not_imply", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "revision": {"type": "string", "minLength": 1},
          "state": {"enum": ["research", "specified", "implemented", "validated"]},
          "external_spec": {"type": "string", "minLength": 1},
          "direction": {"enum": ["import", "export", "bidirectional"]},
          "eigiib_authorities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "mappings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["external_element", "eigiib_element", "relation", "strength"],
              "properties": {
                "external_element": {"type": "string", "minLength": 1},
                "eigiib_element": {"type": "string", "minLength": 1},
                "relation": {"enum": ["transports", "represents", "supplies-evidence", "authenticates", "time-binds", "indexes", "identifies", "policy-evaluates"]},
                "strength": {"enum": ["transport-only", "bounded-semantic", "exact-semantic"]}
              }
            }
          },
          "does_not_imply": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
