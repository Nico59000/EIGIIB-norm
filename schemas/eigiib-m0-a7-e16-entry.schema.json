    "input_contract": {
      "const": {
        "custodian_profile": "versioned custodian identity, authority scope and service boundary",
        "custody_policy": "versioned rules for admissible custody acceptance and evidence",
        "e15_external_object_commitment": "exact E15 object commitment admitted for preservation",
        "e15_final_closure_report": "exact conformant E15-A5 closure report and final freeze",
        "evaluation_context": "fixed purpose, operation, policy revisions and interpretation context",
        "idempotency_key": "operation key preventing silent duplicate placement or migration requests",
        "observation_policy": "versioned timing, spacing, readback and failure-classification rules",
        "placement_policy": "versioned replica-count, location-class and failure-domain declarations",
        "replica_profile": "versioned replica endpoint, provider, implementation and storage-class description",
        "restoration_policy": "versioned restore source, target, content-identity and completion requirements",
        "retention_policy": "versioned bounded retention interval and renewal rules",
        "succession_policy": "versioned custodian replacement, migration, quarantine and rollback rules"
      }
    },
    "methodology_translation": {
      "const": {
        "direct_source_republication": false,
        "mode": "typed-derived-rules-only",
        "rules": [
          {
            "id": "typed-custody-transport",
            "statement": "an E15 object becomes an E16 preservation input only through an explicit source commitment, custodian role, replica role, policy and context"
          },
          {
            "id": "role-separated-preservation-diagnostics",
            "statement": "placement, custody acceptance, retention observation, content readback, restoration and migration remain independently evaluated coordinates"
          },
          {
            "id": "structural-before-preservation-interpretation",
            "statement": "exact E15 lineage and object binding are established before any preservation lifecycle state is interpreted"
          },
          {
            "id": "failure-domain-declaration",
            "statement": "provider, account, region, implementation, process and network-path separation are declared dimensions rather than inferred independence"
          },
          {
            "id": "coincidence-is-not-independence",
            "statement": "different names or locators do not establish independent failure domains without an explicit typed relation"
          },
          {
            "id": "finite-observation-is-not-indefinite-durability",
            "statement": "bounded retention, readback and restore observations do not establish future or perpetual durability"
          },
          {
            "id": "declared-preservation-policy",
            "statement": "no universal replica count or retention horizon is assumed; every composite preservation policy declares its thresholds and precedence"
          }
        ],
        "source_equations_allowed": false,
        "source_specific_terminology_allowed": false,
        "source_status": "external-contextual-methodology-input"
      }
    },
    "multiplatform_closure": {
      "const": {
        "e15_a4_historical_replay_run": 30811560795,
        "e15_a5_final_closure_run": 30811560397,
