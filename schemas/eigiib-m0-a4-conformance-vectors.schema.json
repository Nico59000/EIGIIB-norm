{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schema/eigiib-m0-a4-conformance-vectors.schema.json",
  "title": "EIGIIB M0-A4 Portable Conformance Vectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["standard", "revision", "canonicalization", "supported_contracts", "vectors"],
  "properties": {
    "standard": {"const": "EIGIIB-M0-A4-1.0"},
    "revision": {"type": "string", "minLength": 1},
    "canonicalization": {"const": "m0-a4-json-sha256-v1"},
    "supported_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["M0-A2", "M0-A3"]}
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "contract", "purpose", "fixture_sha256", "fixture", "expect"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "contract": {"enum": ["M0-A2", "M0-A3"]},
          "purpose": {"type": "string", "minLength": 1},
          "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "fixture": {"type": "object"},
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["result_field", "result", "error_codes"],
            "properties": {
              "result_field": {"enum": ["overall_result", "structural_result"]},
              "result": {"enum": ["conformant", "conformant-with-documented-deviations", "incomplete", "non-conformant"]},
              "error_codes": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
