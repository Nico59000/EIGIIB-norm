{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://eigiib.example/schema/p1-a14-report-1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["accepted_history","advisory_binding_result","advisory_envelope_sha256","advisory_id","boundary","claim_boundary","fixed_release_archive_sha256","fixed_release_descriptor_sha256","fixed_release_envelope_sha256","fixed_release_floor_sequence","fixed_release_id","fixed_release_replay_result","live_release_publication_result","overall_result","policy_envelope_sha256","production_release_authorization_result","profile","real_world_vulnerability_resolution_result","remediation_envelope_sha256","remediation_id","remediation_lineage_result","replay_results","revoked_archive_sha256","revoked_release_descriptor_sha256","revoked_release_id","source_revocation_capsule_sha256","source_revocation_report_sha256","standard","tool","tool_version","trusted_effective_time_unix","vulnerability_ids","vulnerability_remediation_result"],
