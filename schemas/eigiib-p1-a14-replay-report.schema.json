    "replay_results":{"type":"array","minItems":5,"maxItems":5,"items":{"type":"object","additionalProperties":false,"required":["decision","id","sequence"],"properties":{"decision":{"enum":["accepted-idempotent-fixed-release-replay","rejected-revoked-predecessor","rejected-fixed-release-content-substitution","rejected-advisory-lineage-mismatch","rejected-below-fixed-release-floor"]},"id":{"type":"string","minLength":1},"sequence":{"type":"integer","minimum":0}}}},
