{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "EIGIIB M0-A13 maintenance plan",
  "required": [
    "maintenanceEventId",
    "successorRevision",
    "affectedPaths",
    "expectedChanges",
    "rollbackTarget",
    "verificationSuites",
    "planDigest"
  ],
  "properties": {
    "maintenanceEventId": {
      "type": "string"
    },
    "successorRevision": {
      "type": "string",
      "pattern": "^M0-R[1-9][0-9]*$"
    },
    "affectedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "expectedChanges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rollbackTarget": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verificationSuites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "planDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
