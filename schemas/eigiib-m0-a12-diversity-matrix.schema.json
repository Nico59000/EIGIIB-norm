{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/eigiib-m0-a12-diversity-matrix.schema.json",
  "title": "EIGIIB M0-A12 control-domain diversity matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard",
    "domains",
    "dimensions",
    "comparisons",
    "decision",
    "payloadDigest"
  ],
  "properties": {
    "standard": {
      "const": "EIGIIB-M0-A12-DIVERSITY-MATRIX-1.0"
    },
    "domains": {
      "const": [
        "github-existing-publication-domain",
        "external-preservation-primary",
        "external-preservation-secondary",
        "independent-observer-primary"
      ]
    },
    "dimensions": {
      "const": [
        "provider-operator",
        "tenant-account",
        "identity-root",
        "privileged-administrator",
        "billing-authority",
        "credential-store",
        "execution-plane",
        "region-or-failure-domain",
        "audit-log-custody"
      ]
    },
    "comparisons": {
      "type": "array",
      "minItems": 54,
      "maxItems": 54,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "left",
          "right",
          "dimension",
          "result",
          "evidenceRefs"
        ],
        "properties": {
          "left": {
            "type": "string"
          },
          "right": {
            "type": "string"
          },
          "dimension": {
            "type": "string"
          },
          "result": {
            "enum": [
              "distinct",
              "shared"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "decision": {
      "const": "required-independence-established-for-point-in-time-activation"
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
