{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/eigiib-m0-a12-campaign-anchor.schema.json",
  "title": "EIGIIB M0-A12 observation campaign activation anchor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard",
    "campaignId",
    "activatedAt",
    "sourceM0A12Head",
    "observerDomainId",
    "observerKeyId",
    "expectedChannelIds",
    "initialObjectVersionIds",
    "schedule",
    "approvalEvidenceRefs",
    "payloadDigest"
  ],
  "properties": {
    "standard": {
      "const": "EIGIIB-M0-A12-CAMPAIGN-ANCHOR-1.0"
    },
    "campaignId": {
      "const": "eigiib-m0-a11-external-preservation-observation-v1"
    },
    "activatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceM0A12Head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "observerDomainId": {
      "const": "independent-observer-primary"
    },
    "observerKeyId": {
      "type": "string",
      "minLength": 1
    },
    "expectedChannelIds": {
      "const": [
        "immutable-channel-primary",
        "immutable-channel-secondary"
      ]
    },
    "initialObjectVersionIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "immutable-channel-primary",
        "immutable-channel-secondary"
      ],
      "properties": {
        "immutable-channel-primary": {
          "type": "string",
          "minLength": 1
        },
        "immutable-channel-secondary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cadenceSeconds",
        "graceSeconds",
        "lapseAfterSeconds",
        "clock"
      ],
      "properties": {
        "cadenceSeconds": {
          "const": 86400
        },
        "graceSeconds": {
          "const": 21600
        },
        "lapseAfterSeconds": {
          "const": 172800
        },
        "clock": {
          "const": "utc-rfc3339"
        }
      }
    },
    "approvalEvidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
