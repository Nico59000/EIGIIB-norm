{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/eigiib/e7-recovery-hardening.schema.json",
  "title": "EIGIIB-E7 supplementary recovery hardening profile",
  "type": "object",
  "properties": {
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "e4_decision": {"type": "string", "minLength": 1},
          "e5_decision": {"type": "string", "minLength": 1},
          "e6_evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["incident"],
        "properties": {
          "incident": {"type": "string", "minLength": 1},
          "require_e4_authenticated": {"type": "boolean"},
          "e4_decision": {"type": "string", "minLength": 1},
          "require_e5_history_bound": {"type": "boolean"},
          "e5_decision": {"type": "string", "minLength": 1},
          "require_e6_evidence": {"type": "boolean"},
          "e6_evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "rollback_records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason"],
        "properties": {
          "reason": {"type": "string", "minLength": 1},
          "replacement_transition": {"type": "string", "minLength": 1}
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prior_closure": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    }
  }
}
