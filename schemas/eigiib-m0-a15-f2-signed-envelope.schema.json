{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/eigiib-m0-a15-f2-signed-envelope.schema.json",
  "title": "EIGIIB M0-A15-F2 signed envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {"type": "object"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "keyId": {"type": "string", "minLength": 1},
        "value": {"type": "string", "contentEncoding": "base64"}
      }
    }
  }
}
