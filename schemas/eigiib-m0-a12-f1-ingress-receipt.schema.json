{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/eigiib-m0-a12-f1-ingress-receipt.schema.json",
  "title": "EIGIIB M0-A12-F1 ingress receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard",
    "sourceAuthorityHead",
    "archiveSha256",
    "manifestDigest",
    "payloadSetDigest",
    "evidenceSetDigest",
    "entryCount",
    "result",
    "verifiedAt",
    "receiptDigest"
  ],
  "properties": {
    "standard": {
      "const": "EIGIIB-M0-A12-F1-INGRESS-RECEIPT-1.0"
    },
    "sourceAuthorityHead": {
      "const": "e6661993924aed4d0185df48cf0b8587b2e0abf3"
    },
    "archiveSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payloadSetDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidenceSetDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entryCount": {
      "type": "integer",
      "minimum": 17,
      "maximum": 512
    },
    "result": {
      "enum": [
        "verified-and-staged-not-bound",
        "verified-and-bound"
      ]
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "receiptDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
