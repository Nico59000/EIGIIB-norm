{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/eigiib-p1-a2-sigstore-bundle.schema.json",
  "title": "EIGIIB P1-A2 Sigstore signed bundle capsule",
  "type": "object",
  "additionalProperties": false,
  "required": ["standard", "profile", "external_spec", "crypto_profile", "trust_scope", "bundle", "binding", "claimBoundary"],
  "properties": {
    "standard": {"const": "EIGIIB-P1-A2-1.0"},
    "profile": {"const": "sigstore-p1-a1-dsse-bundle-v1"},
    "external_spec": {"const": "sigstore-bundle-0.3.2"},
    "crypto_profile": {"const": "ed25519-spki-openssl-v1"},
    "trust_scope": {"const": "supplied-public-key-only"},
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "verificationMaterial", "dsseEnvelope"],
      "properties": {
        "mediaType": {"const": "application/vnd.dev.sigstore.bundle.v0.3+json"},
        "verificationMaterial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publicKeyIdentifier"],
          "properties": {
            "publicKeyIdentifier": {
              "type": "object",
              "additionalProperties": false,
              "required": ["hint"],
              "properties": {"hint": {"type": "string", "pattern": "^p1-a2-ed25519-spki-sha256:[0-9a-f]{64}$"}}
            }
          }
        },
        "dsseEnvelope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["payload", "payloadType", "signatures"],
          "properties": {
            "payload": {"type": "string", "minLength": 1},
            "payloadType": {"const": "application/vnd.in-toto+json"},
            "signatures": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["keyid", "sig"],
                "properties": {
                  "keyid": {"type": "string", "pattern": "^p1-a2-ed25519-spki-sha256:[0-9a-f]{64}$"},
                  "sig": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p1A1Statement", "publicKeySpki"],
      "properties": {
        "p1A1Statement": {"$ref": "#/$defs/identity"},
        "publicKeySpki": {"$ref": "#/$defs/identity"}
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "signatureValidity", "doesNotImply"],
      "properties": {
        "authority": {"const": "e4"},
        "signatureValidity": {"const": "cryptographic-signature-valid-for-supplied-public-key"},
        "doesNotImply": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "bytes"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
