{
  "$id": "https://eigiib.example/schemas/eigiib-p1-a16-capsule.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "const": "Ed25519"
    },
    "keyId": {
      "pattern": "sha256:[0-9a-f]{64}",
      "type": "string"
    },
    "payload": {
      "type": "string"
    },
    "signature": {
      "type": "string"
    },
    "standard": {
      "const": "EIGIIB-P1-A16-CAPSULE-1.0"
    }
  },
  "required": [
    "algorithm",
    "keyId",
    "payload",
    "signature",
    "standard"
  ],
  "type": "object"
}
