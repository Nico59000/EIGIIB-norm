{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/eigiib-m0-a15-reconciliation-record.schema.json",
  "title": "EIGIIB M0 A15 Reconciliation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordDigest",
    "eventIds",
    "commonAncestorDigest",
    "candidateHeads",
    "authoritativeHead",
    "supportingRegistryIds",
    "quarantinedRegistryIds",
    "witnessEndorsements",
    "appendOnly",
    "staleHeadsRejected",
    "quarantinedRegistryReadbackValid",
    "independentPublishedReadbackValid",
    "governanceReconciliationValid"
  ],
  "properties": {
    "recordDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "eventIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "commonAncestorDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidateHeads": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "authoritativeHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "supportingRegistryIds": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "quarantinedRegistryIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "witnessEndorsements": {
      "type": "array",
      "minItems": 4
    },
    "appendOnly": {
      "const": true
    },
    "staleHeadsRejected": {
      "const": true
    },
    "quarantinedRegistryReadbackValid": {
      "const": true
    },
    "independentPublishedReadbackValid": {
      "const": true
    },
    "governanceReconciliationValid": {
      "const": true
    }
  }
}
