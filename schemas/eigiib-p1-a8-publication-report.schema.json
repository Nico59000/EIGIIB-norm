{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/p1-a8-publication-report-1.0.json",
  "title": "EIGIIB P1-A8 independent publication replay report",
  "type": "object",
  "additionalProperties": false,
  "required": ["standard", "profile", "tool", "tool_version", "release_id", "source_commit", "authority_root", "bundle_sha256", "bundle_bytes", "embedded_manifest_sha256", "source_tree_root", "source_entry_count", "publishers", "platforms", "publisher_byte_equivalence_result", "release_digest_result", "archive_structure_result", "archive_content_result", "offline_a7_authority_result", "offline_a7_route_replay_result", "independent_publication_replay_result", "overall_result", "findings", "claim_boundary"],
  "properties": {
    "standard": {"const": "EIGIIB-P1-A8-REPLAY-1.0"},
    "profile": {"const": "independent-publication-replay-v1"},
    "tool": {"const": "eigiib-p1-a8-publication-replay"},
    "tool_version": {"const": "0.1.0"},
    "release_id": {"type": "string", "minLength": 1},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authority_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_bytes": {"type": "integer", "minimum": 1},
    "embedded_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_tree_root": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_entry_count": {"type": "integer", "minimum": 1},
    "publishers": {"const": ["reference-python-stdlib", "independent-go-stdlib"]},
    "platforms": {"const": ["ubuntu-24.04", "macos-15", "windows-2025"]},
    "publisher_byte_equivalence_result": {"const": "conformant"},
    "release_digest_result": {"const": "conformant"},
    "archive_structure_result": {"const": "conformant"},
    "archive_content_result": {"const": "conformant"},
    "offline_a7_authority_result": {"const": "conformant"},
    "offline_a7_route_replay_result": {"const": "conformant"},
    "independent_publication_replay_result": {"const": "conformant"},
    "overall_result": {"const": "conformant"},
    "findings": {"const": []},
    "claim_boundary": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
