{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/eigiib-m0-a15-reconciliation-checkpoint.schema.json",
  "title": "EIGIIB M0 A15 Reconciliation Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "observedAt",
    "checkpointDigest",
    "cycleTipDigest",
    "governanceSnapshotDigest",
    "registryReceipts",
    "witnessEndorsements",
    "splitBrainEvents"
  ],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "previousCheckpointDigest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "previousCycleTipDigest": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpointDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cycleTipDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "governanceSnapshotDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registryReceipts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "witnessEndorsements": {
      "type": "array",
      "minItems": 4
    },
    "splitBrainEvents": {
      "type": "array"
    },
    "reconciliationRecord": {
      "type": [
        "object",
        "null"
      ]
    },
    "governanceReconciliation": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
