{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/eigiib-m0-a15-f1-reconciliation-record.schema.json",
  "title": "EIGIIB M0-A15-F1 Authenticated Reconciliation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payload",
    "witnessEndorsements",
    "readbacks"
  ],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "commonAncestorCheckpointDigest",
        "derivedSplitBrainProofDigest",
        "candidateViewDigests",
        "authoritativeViewDigest",
        "supportingRegistryIds",
        "quarantinedRegistryIds",
        "appendOnly",
        "staleViewsRejected"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "commonAncestorCheckpointDigest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "derivedSplitBrainProofDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "candidateViewDigests": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "authoritativeViewDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "supportingRegistryIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quarantinedRegistryIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "appendOnly": {
          "const": true
        },
        "staleViewsRejected": {
          "const": true
        }
      }
    },
    "witnessEndorsements": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "https://eigiib.example/schemas/eigiib-m0-a15-f1-signed-envelope.schema.json"
      }
    },
    "readbacks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "https://eigiib.example/schemas/eigiib-m0-a15-f1-signed-envelope.schema.json"
      }
    }
  }
}
