{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://eigiib.example/schemas/p1-a9-route-result.json",
  "type":"object","additionalProperties":false,
  "required":["standard","route","release_id","release_descriptor_sha256","release_envelope_sha256","supersession_envelope_sha256","transparency_root","registered_entry_count","accepted","boundary"],
  "properties":{
    "standard":{"const":"EIGIIB-P1-A9-ROUTE-1.0"},
    "route":{"enum":["reference-python-openssl","independent-go-stdlib","external-go-cose"]},
    "release_id":{"const":"eigiib-p1-a7-authority-1.0"},
    "release_descriptor_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "release_envelope_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "supersession_envelope_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "transparency_root":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "registered_entry_count":{"const":2},
    "accepted":{"const":true},
    "boundary":{"const":"supersession-current-authority"}
  }
}
