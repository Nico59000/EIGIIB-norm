{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "M0-A14 continuity certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificateId",
    "sourceA13Head",
    "firstCycleSequence",
    "lastCycleSequence",
    "cycleCount",
    "observedSpanSeconds",
    "latestRefreezeDigest",
    "revocationEventCount",
    "governanceTransitionCount",
    "cycleChainDigest",
    "issuedAt",
    "independentVerifierId"
  ],
  "properties": {
    "certificateId": {
      "type": "string",
      "minLength": 1
    },
    "sourceA13Head": {
      "const": "d096b9fbf68cead15a3a9eb7bf4cff1493a0aa45"
    },
    "firstCycleSequence": {
      "const": 1
    },
    "lastCycleSequence": {
      "type": "integer",
      "minimum": 3
    },
    "cycleCount": {
      "type": "integer",
      "minimum": 3
    },
    "observedSpanSeconds": {
      "type": "integer",
      "minimum": 2592000
    },
    "latestRefreezeDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revocationEventCount": {
      "type": "integer",
      "minimum": 1
    },
    "governanceTransitionCount": {
      "type": "integer",
      "minimum": 0
    },
    "cycleChainDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "independentVerifierId": {
      "type": "string",
      "minLength": 1
    }
  }
}
