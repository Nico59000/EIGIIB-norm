{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/eigiib-e16-a4-authority-freeze.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard",
    "status",
    "profile_revision",
    "source_e16_a3_commit",
    "authorities"
  ],
  "properties": {
    "standard": {
      "const": "EIGIIB-E16-A4-FREEZE-1.0"
    },
    "status": {
      "const": "frozen"
    },
    "profile_revision": {
      "const": "EIGIIB-E16-draft-1.0"
    },
    "source_e16_a3_commit": {
      "const": "74cb64ebcb1b51b0a035e755be413dbd2a7e9e3e"
    },
    "authorities": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "enum": [
              ".github/workflows/e16-a4-custodian-succession-recovery.yml",
              "conformance/E16-A4-MANUAL-REVIEW.md",
              "conformance/custodian-succession-recovery.json",
              "conformance/e16-a4-adoption-transition.json",
              "conformance/e16-a4-authority-manifest.json",
              "docs/E16-A4-HUMAN-MASTERY-GUIDE.md",
              "extensions/E16-A4-CUSTODIAN-SUCCESSION-REPLICA-MIGRATION-LOSS-QUARANTINE-ANTI-ROLLBACK-RECOVERY.md",
              "schemas/eigiib-e16-a4-adoption-transition.schema.json",
              "schemas/eigiib-e16-a4-authority-freeze.schema.json",
              "schemas/eigiib-e16-a4-authority-manifest.schema.json",
              "schemas/eigiib-e16-a4-custodian-succession-recovery.schema.json",
              "tests/fixtures/e16-a4/expected-report.json",
              "tests/test_eigiib_custodian_succession_recovery.py",
              "tools/eigiib_custodian_succession_recovery_check.py",
              "tools/eigiib_historical_e16_a3_replay.py"
            ]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
