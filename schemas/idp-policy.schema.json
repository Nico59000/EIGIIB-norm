{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/idp-policy.schema.json",
  "title": "EIGIIB IDP-A1 policy registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["standard","profileState","registryScope","classes","channels","authorities","rules","artifacts","derivations"],
  "properties": {
    "standard": {"const": "EIGIIB-IDP-A1-0.1"},
    "profileState": {"enum": ["draft","active","retired"]},
    "registryScope": {"enum": ["structural-only","operational"]},
    "classes": {"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/class"}},
    "channels": {"type":"array","minItems":5,"items":{"$ref":"#/$defs/channel"}},
    "authorities": {"type":"array","minItems":3,"items":{"$ref":"#/$defs/authority"}},
    "rules": {"$ref":"#/$defs/rules"},
    "artifacts": {"type":"array","items":{"$ref":"#/$defs/artifact"}},
    "derivations": {"type":"array","items":{"$ref":"#/$defs/derivation"}}
  },
  "$defs": {
    "class": {
      "type":"object","additionalProperties":false,
      "required":["id","name","visibility","restrictionRank","surface"],
      "properties":{
        "id":{"enum":["D0","D1","D2","D3","D4","D5"]},
        "name":{"type":"string","minLength":1},
        "visibility":{"enum":["public","controlled","restricted","secret"]},
        "restrictionRank":{"type":"integer","minimum":0,"maximum":3},
        "surface":{"type":"string","minLength":1}
      }
    },
    "channel": {
      "type":"object","additionalProperties":false,
      "required":["id","kind","direction","allowedClasses","authoritativeRoot","ingressDisposition","requiresDerivedArtifact","namedAudienceRequired"],
      "properties":{
        "id":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},
        "direction":{"enum":["internal","outbound","inbound","bidirectional"]},
        "allowedClasses":{"type":"array","uniqueItems":true,"items":{"enum":["D0","D1","D2","D3","D4","D5"]}},
        "authoritativeRoot":{"type":"boolean"},
        "ingressDisposition":{"enum":["not-applicable","quarantined"]},
        "requiresDerivedArtifact":{"type":"boolean"},
        "namedAudienceRequired":{"type":"boolean"}
      }
    },
    "authority": {
      "type":"object","additionalProperties":false,
      "required":["id","role","bindingState"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "role":{"enum":["root-authority","disclosure-authority","publisher"]},
        "bindingState":{"enum":["logical-only","operationally-bound"]}
      }
    },
    "rules": {
      "type":"object","additionalProperties":false,
      "required":["publicClasses","bridgeForbiddenClasses","directPublicReleaseForbiddenClasses","classChangeRequiresNewIdentity","declassificationRequiresDerivedArtifact","declassificationRequiresLocalDecisionAuthority","inboundBridgeDefaultState","bridgeRootAuthorityForbidden","d5ExternalArtifactMetadataForbidden","productionSecretMaterialInGitForbidden","restrictedExternalCommitmentMode"],
      "properties":{
        "publicClasses":{"const":["D0","D1","D2"]},
        "bridgeForbiddenClasses":{"const":["D5"]},
        "directPublicReleaseForbiddenClasses":{"const":["D3","D4","D5"]},
        "classChangeRequiresNewIdentity":{"const":true},
        "declassificationRequiresDerivedArtifact":{"const":true},
        "declassificationRequiresLocalDecisionAuthority":{"const":true},
        "inboundBridgeDefaultState":{"const":"quarantined"},
        "bridgeRootAuthorityForbidden":{"const":true},
        "d5ExternalArtifactMetadataForbidden":{"const":true},
        "productionSecretMaterialInGitForbidden":{"const":true},
        "restrictedExternalCommitmentMode":{"const":"opaque-randomized"}
      }
    },
    "artifact": {
      "type":"object","additionalProperties":false,
      "required":["id","classification","channelId","authorityId","state","payloadPresent","commitmentMode","commitment","derivedFrom","namedAudience","synthetic"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "classification":{"enum":["D0","D1","D2","D3","D4","D5"]},
        "channelId":{"type":"string","minLength":1},
        "authorityId":{"type":"string","minLength":1},
        "state":{"enum":["prepared","released","retained","quarantined"]},
        "payloadPresent":{"type":"boolean"},
        "commitmentMode":{"enum":["none","content-digest","opaque-randomized"]},
        "commitment":{"type":["string","null"]},
        "derivedFrom":{"type":["string","null"]},
        "namedAudience":{"type":["string","null"]},
        "synthetic":{"type":"boolean"}
      }
    },
    "derivation": {
      "type":"object","additionalProperties":false,
      "required":["id","sourceArtifactId","derivedArtifactId","sourceClass","targetClass","method","authorityId","approvalIds","claimBoundary","state"],
      "properties":{
        "id":{"type":"string","minLength":1},
        "sourceArtifactId":{"type":"string","minLength":1},
        "derivedArtifactId":{"type":"string","minLength":1},
        "sourceClass":{"enum":["D0","D1","D2","D3","D4","D5"]},
        "targetClass":{"enum":["D0","D1","D2","D3","D4","D5"]},
        "method":{"const":"minimized-derivation"},
        "authorityId":{"type":"string","minLength":1},
        "approvalIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
        "claimBoundary":{"type":"string","minLength":1},
        "state":{"enum":["prepared","approved","rejected"]}
      }
    }
  }
}
