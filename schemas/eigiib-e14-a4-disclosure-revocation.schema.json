{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/eigiib/schemas/eigiib-e14-a4-disclosure-revocation.schema.json",
  "title": "EIGIIB E14-A4 disclosure revocation registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["standard", "status", "upstream_projection_registry", "upstream_authorization_registry", "upstream_correlation_registry", "freshness_sources", "distribution_channels", "status_histories", "disclosure_attempts", "decisions"],
  "properties": {
    "standard": {"const": "EIGIIB-E14-A4-1.0"},
    "status": {"const": "structural-only"},
    "upstream_projection_registry": {"const": "conformance/confidential-evidence.json"},
    "upstream_authorization_registry": {"const": "conformance/disclosure-authorization.json"},
    "upstream_correlation_registry": {"const": "conformance/correlation-control.json"},
    "freshness_sources": {"type": "array", "items": {"$ref": "#/$defs/freshness"}},
    "distribution_channels": {"type": "array", "items": {"$ref": "#/$defs/distribution"}},
    "status_histories": {"type": "array", "items": {"$ref": "#/$defs/history"}},
    "disclosure_attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "commitment": {"type": "object", "additionalProperties": false, "required": ["algorithm", "digest"], "properties": {"algorithm": {"const": "sha256"}, "digest": {"$ref": "#/$defs/digest"}}},
    "freshness": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "state", "current_epoch"], "properties": {"id": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/id"}, "state": {"enum": ["active", "revoked", "contested", "unavailable"]}, "current_epoch": {"type": "integer", "minimum": 0}}},
    "distribution": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "state", "projection", "projection_revision", "projection_commitment", "audience", "purpose", "endpoint", "commitment"], "properties": {"id": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/id"}, "state": {"enum": ["active", "withdrawn", "contested", "unavailable"]}, "projection": {"$ref": "#/$defs/id"}, "projection_revision": {"$ref": "#/$defs/id"}, "projection_commitment": {"$ref": "#/$defs/digest"}, "audience": {"$ref": "#/$defs/id"}, "purpose": {"$ref": "#/$defs/id"}, "endpoint": {"$ref": "#/$defs/id"}, "commitment": {"$ref": "#/$defs/commitment"}}},
    "predecessor": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["id", "commitment"], "properties": {"id": {"$ref": "#/$defs/id"}, "commitment": {"$ref": "#/$defs/digest"}}}]},
    "history": {"type": "object", "additionalProperties": false, "required": ["id", "authority", "authority_revision", "subject_kind", "subject", "subject_revision", "subject_commitment", "generation", "predecessor", "state", "observed_epoch", "valid_until_epoch", "evidence", "commitment"], "properties": {"id": {"$ref": "#/$defs/id"}, "authority": {"$ref": "#/$defs/id"}, "authority_revision": {"$ref": "#/$defs/id"}, "subject_kind": {"enum": ["source-record", "projection", "distribution"]}, "subject": {"$ref": "#/$defs/id"}, "subject_revision": {"$ref": "#/$defs/id"}, "subject_commitment": {"$ref": "#/$defs/digest"}, "generation": {"type": "integer", "minimum": 1}, "predecessor": {"$ref": "#/$defs/predecessor"}, "state": {"enum": ["active", "revoked", "withdrawn", "superseded", "unavailable"]}, "observed_epoch": {"type": "integer", "minimum": 0}, "valid_until_epoch": {"type": "integer", "minimum": 0}, "evidence": {"$ref": "#/$defs/strings"}, "commitment": {"$ref": "#/$defs/commitment"}}},
    "headref": {"type": "object", "additionalProperties": false, "required": ["id", "commitment", "minimum_generation"], "properties": {"id": {"$ref": "#/$defs/id"}, "commitment": {"$ref": "#/$defs/digest"}, "minimum_generation": {"type": "integer", "minimum": 1}}},
    "attempt": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "source_record", "source_revision", "source_commitment", "projection", "projection_revision", "projection_commitment", "authorization_request", "authorization_request_revision", "authorization_decision", "authorization_decision_request_revision", "enforcement_request", "enforcement_request_revision", "correlation_consumption", "correlation_consumption_revision", "distribution", "distribution_revision", "distribution_commitment", "freshness_source", "freshness_source_revision", "evaluation_epoch", "source_head", "projection_head", "distribution_head"], "properties": {"id": {"$ref": "#/$defs/id"}, "revision": {"$ref": "#/$defs/id"}, "source_record": {"$ref": "#/$defs/id"}, "source_revision": {"$ref": "#/$defs/id"}, "source_commitment": {"$ref": "#/$defs/digest"}, "projection": {"$ref": "#/$defs/id"}, "projection_revision": {"$ref": "#/$defs/id"}, "projection_commitment": {"$ref": "#/$defs/digest"}, "authorization_request": {"$ref": "#/$defs/id"}, "authorization_request_revision": {"$ref": "#/$defs/id"}, "authorization_decision": {"$ref": "#/$defs/id"}, "authorization_decision_request_revision": {"$ref": "#/$defs/id"}, "enforcement_request": {"$ref": "#/$defs/id"}, "enforcement_request_revision": {"$ref": "#/$defs/id"}, "correlation_consumption": {"$ref": "#/$defs/id"}, "correlation_consumption_revision": {"$ref": "#/$defs/id"}, "distribution": {"$ref": "#/$defs/id"}, "distribution_revision": {"$ref": "#/$defs/id"}, "distribution_commitment": {"$ref": "#/$defs/digest"}, "freshness_source": {"$ref": "#/$defs/id"}, "freshness_source_revision": {"$ref": "#/$defs/id"}, "evaluation_epoch": {"type": "integer", "minimum": 0}, "source_head": {"$ref": "#/$defs/headref"}, "projection_head": {"$ref": "#/$defs/headref"}, "distribution_head": {"$ref": "#/$defs/headref"}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["id", "attempt", "attempt_revision", "state", "source_status_result", "projection_status_result", "distribution_status_result", "freshness_result", "rollback_result", "authorization_result", "correlation_result", "evaluator", "reasons", "evidence"], "properties": {"id": {"$ref": "#/$defs/id"}, "attempt": {"$ref": "#/$defs/id"}, "attempt_revision": {"$ref": "#/$defs/id"}, "state": {"enum": ["admissible", "rejected", "held", "unavailable"]}, "source_status_result": {"enum": ["active", "revoked", "withdrawn", "superseded", "held", "unavailable"]}, "projection_status_result": {"enum": ["active", "revoked", "withdrawn", "superseded", "held", "unavailable"]}, "distribution_status_result": {"enum": ["available", "withdrawn", "superseded", "held", "unavailable"]}, "freshness_result": {"enum": ["fresh", "stale", "not-yet-effective", "held", "unavailable"]}, "rollback_result": {"enum": ["current", "rollback-detected", "held", "unavailable"]}, "authorization_result": {"enum": ["permit", "deny", "held", "unavailable"]}, "correlation_result": {"enum": ["committed", "rejected", "held", "unavailable"]}, "evaluator": {"$ref": "#/$defs/id"}, "reasons": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "evidence": {"$ref": "#/$defs/strings"}}}
  }
}
