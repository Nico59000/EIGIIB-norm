{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/p1-a8-release-1.0.json",
  "title": "EIGIIB P1-A8 detached release descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard",
    "profile",
    "releaseId",
    "sourceCommit",
    "authorityRoot",
    "bundle",
    "embeddedManifest",
    "sourceTreeRoot",
    "requiredPublishers",
    "requiredPlatforms",
    "claimBoundary"
  ],
  "properties": {
    "standard": {
      "const": "EIGIIB-P1-A8-RELEASE-1.0"
    },
    "profile": {
      "const": "exact-ustar-source-distribution-v1"
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "authorityRoot": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bundle": {
      "$ref": "#/$defs/fileIdentity"
    },
    "embeddedManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "bytes",
        "sha256",
        "sourceEntryCount"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceEntryCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sourceTreeRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256-over-path-mode-size-sha256-gitblob-v1"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "requiredPublishers": {
      "const": [
        "reference-python-stdlib",
        "independent-go-stdlib"
      ]
    },
    "requiredPlatforms": {
      "const": [
        "ubuntu-24.04",
        "macos-15",
        "windows-2025"
      ]
    },
    "claimBoundary": {
      "type": "object",
      "required": [
        "doesNotImply"
      ],
      "properties": {
        "doesNotImply": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bytes",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
