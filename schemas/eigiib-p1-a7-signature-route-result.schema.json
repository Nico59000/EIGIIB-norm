{
  "$id": "https://eigiib.example/schemas/eigiib-p1-a7-signature-route-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "accepted": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "boundary": {
            "const": "signature"
          },
          "error_class": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "accepted": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "error_class": {
            "type": "string"
          }
        }
      }
    }
  ],
  "properties": {
    "accepted": {
      "type": "boolean"
    },
    "boundary": {
      "enum": [
        "manifest",
        "dsse",
        "signature-carrier",
        "signature"
      ]
    },
    "error_class": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "manifest.invalid",
            "signature.malformed",
            "signature.invalid"
          ]
        }
      ]
    },
    "route": {
      "enum": [
        "reference-python-openssl",
        "independent-go-stdlib",
        "external-go-cose"
      ]
    },
    "standard": {
      "const": "EIGIIB-P1-A7.4-1.0"
    },
    "vector_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "standard",
    "route",
    "vector_id",
    "accepted",
    "error_class",
    "boundary"
  ],
  "title": "EIGIIB P1-A7.4 portable manifest, DSSE and signature result",
  "type": "object"
}
