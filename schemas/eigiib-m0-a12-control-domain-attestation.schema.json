{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/eigiib-m0-a12-control-domain-attestation.schema.json",
  "title": "EIGIIB M0-A12 bound external control-domain attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard",
    "domainId",
    "role",
    "providerOperator",
    "service",
    "tenantAccountId",
    "identityRoot",
    "privilegedAdministratorSet",
    "billingAuthority",
    "credentialStore",
    "executionPlane",
    "regionOrFailureDomain",
    "auditLogCustody",
    "issuedAt",
    "evidenceRefs",
    "signerKeyId",
    "payloadDigest",
    "claimBoundary"
  ],
  "properties": {
    "standard": {
      "const": "EIGIIB-M0-A12-CONTROL-DOMAIN-ATTESTATION-1.0"
    },
    "domainId": {
      "enum": [
        "external-preservation-primary",
        "external-preservation-secondary",
        "independent-observer-primary"
      ]
    },
    "role": {
      "enum": [
        "preservation-custodian",
        "independent-observer"
      ]
    },
    "providerOperator": {
      "type": "string",
      "minLength": 1
    },
    "service": {
      "type": "string",
      "minLength": 1
    },
    "tenantAccountId": {
      "type": "string",
      "minLength": 1
    },
    "identityRoot": {
      "type": "string",
      "minLength": 1
    },
    "privilegedAdministratorSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "billingAuthority": {
      "type": "string",
      "minLength": 1
    },
    "credentialStore": {
      "type": "string",
      "minLength": 1
    },
    "executionPlane": {
      "type": "string",
      "minLength": 1
    },
    "regionOrFailureDomain": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "auditLogCustody": {
      "type": "string",
      "minLength": 1
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "signerKeyId": {
      "type": "string",
      "minLength": 1
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claimBoundary": {
      "const": "bounded-point-in-time-control-domain-attestation"
    }
  }
}
