{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/eigiib-e15-a1-authority-freeze.schema.json",
  "title": "EIGIIB E15-A1 authority freeze",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard",
    "status",
    "source",
    "profile_revision",
    "authorities"
  ],
  "properties": {
    "standard": {
      "const": "EIGIIB-E15-A1-FREEZE-1.0"
    },
    "status": {
      "const": "frozen"
    },
    "source": {
      "type": "object"
    },
    "profile_revision": {
      "const": "EIGIIB-E15-draft-1.0"
    },
    "authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
