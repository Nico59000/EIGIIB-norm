{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/eigiib/schemas/eigiib-e14-confidential-evidence.schema.json",
  "title": "EIGIIB E14 confidential evidence registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["standard", "revision", "status", "records", "projections"],
  "properties": {
    "standard": {"const": "EIGIIB-1.0+E1-1.0+E2-1.0+E3-1.0+E4-1.0+E5-1.0+E6-1.0+E7-1.0+E8-1.0+E9-1.0+E10-1.0+E11-1.0+E12-1.0+E13-1.0+E14-1.0"},
    "revision": {"const": "EIGIIB-E14-draft-1.0"},
    "status": {"const": "structural-only"},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "projections": {"type": "array", "items": {"$ref": "#/$defs/projection"}}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}}
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {"algorithm": {"const": "sha256"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "subject", "predicate", "object", "scope", "assurance", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "object": {},
        "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "assurance": {"type": "integer", "minimum": 0, "maximum": 4},
        "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "projectedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_claim", "type", "subject", "predicate", "object", "scope", "assurance", "evidence"],
      "properties": {
        "source_claim": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "predicate": {"type": "string", "minLength": 1},
        "object": {},
        "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "assurance": {"type": "integer", "minimum": 0, "maximum": 4},
        "evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "subject", "classification", "source_authority", "artifact", "claims", "revocation_state", "commitment"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "classification": {"enum": ["restricted", "confidential", "highly-confidential"]},
        "source_authority": {"type": "string", "minLength": 1},
        "artifact": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "algorithm", "digest", "bytes"],
          "properties": {
            "path": {"type": "string", "minLength": 1}, "algorithm": {"const": "sha256"},
            "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}
          }
        },
        "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "revocation_state": {"enum": ["active", "revoked", "withdrawn", "unavailable"]},
        "commitment": {"$ref": "#/$defs/commitment"}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "state", "source_record", "source_revision", "source_artifact_digest", "source_commitment", "authorized_audience", "disclosure_policy", "evaluation_context", "correlation_controls", "claims", "omitted_claims", "commitment"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1},
        "state": {"enum": ["prepared", "sealed"]}, "source_record": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1}, "source_artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_commitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authorized_audience": {"$ref": "#/$defs/identity"}, "disclosure_policy": {"$ref": "#/$defs/identity"},
        "evaluation_context": {"$ref": "#/$defs/identity"},
        "correlation_controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/projectedClaim"}},
        "omitted_claims": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "commitment": {"$ref": "#/$defs/commitment"}
      }
    }
  }
}
