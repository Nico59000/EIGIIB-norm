{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/eigiib-m0-a15-f1-derived-split-brain-proof.schema.json",
  "title": "EIGIIB M0-A15-F1 Derived Split-Brain Proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "receiptDigests",
    "candidateViewDigests",
    "divergentRegistryIds",
    "proofDigest"
  ],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "receiptDigests": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "candidateViewDigests": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "divergentRegistryIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proofDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
