{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/eigiib-m0-a9-cross-lineage-reconciliation.schema.json",
  "title": "EIGIIB M0-A9 cross-lineage capability reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard",
    "status",
    "source",
    "governance",
    "claim_classes",
    "capabilities",
    "cross_extension_index",
    "manual_gate",
    "authority_freeze",
    "nonclaims"
  ],
  "properties": {
    "standard": {"const": "EIGIIB-M0-A9-CROSS-LINEAGE-RECONCILIATION-1.0"},
    "status": {"const": "cross-lineage-capability-boundaries-reconciled"},
    "source": {"type": "object"},
    "governance": {"type": "object"},
    "claim_classes": {"type": "array", "minItems": 5, "maxItems": 5},
    "capabilities": {"type": "array", "minItems": 7, "maxItems": 7},
    "cross_extension_index": {"type": "array", "minItems": 2, "maxItems": 2},
    "manual_gate": {"type": "object"},
    "authority_freeze": {"type": "object"},
    "nonclaims": {"type": "array", "minItems": 11, "uniqueItems": true}
  }
}
