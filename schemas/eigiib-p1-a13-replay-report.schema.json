{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://eigiib.example/schema/p1-a13-report-1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["accepted_history","anti_rollback_floor_sequence","anti_rollback_result","boundary","claim_boundary","content_archive_sha256","content_revocation_result","distribution_withdrawal_result","global_content_unavailability_result","overall_result","policy_envelope_sha256","profile","registered_channel_ids","release_descriptor_sha256","release_id","replay_results","revocation_envelope_sha256","revocation_id","revocation_sequence","source_transparency_capsule_sha256","source_transparency_report_sha256","standard","tool","tool_version","trusted_effective_time_unix","vulnerability_remediation_result","withdrawn_channel_ids"],
  "properties":{
    "accepted_history":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"string"}},
    "anti_rollback_floor_sequence":{"const":31},
    "anti_rollback_result":{"const":"conformant-for-revocation-floor-and-registered-channel-history-scope"},
    "boundary":{"const":"registered-content-revocation-distribution-withdrawal-anti-rollback-closure"},
    "claim_boundary":{"type":"array","minItems":7,"maxItems":7,"uniqueItems":true,"items":{"type":"string"}},
    "content_archive_sha256":{"$ref":"#/$defs/digest"},
    "content_revocation_result":{"const":"conformant-for-exact-release-content-scope"},
    "distribution_withdrawal_result":{"const":"conformant-for-two-registered-fixture-channels-scope"},
    "global_content_unavailability_result":{"const":"not-claimed"},
    "overall_result":{"const":"conformant"},
    "policy_envelope_sha256":{"$ref":"#/$defs/digest"},
    "profile":{"const":"registered-content-revocation-withdrawal-anti-rollback-v1"},
    "registered_channel_ids":{"const":["fixture-primary","fixture-mirror"]},
    "release_descriptor_sha256":{"$ref":"#/$defs/digest"},
    "release_id":{"const":"eigiib-p1-a7-authority-1.0"},
    "replay_results":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["decision","id","sequence"],"properties":{"decision":{"enum":["rejected-below-revocation-floor","rejected-revoked-content"]},"id":{"type":"string"},"sequence":{"type":"integer"}}}},
    "revocation_envelope_sha256":{"$ref":"#/$defs/digest"},
    "revocation_id":{"const":"eigiib-p1-a13-revocation-1"},
    "revocation_sequence":{"const":31},
    "source_transparency_capsule_sha256":{"$ref":"#/$defs/digest"},
    "source_transparency_report_sha256":{"$ref":"#/$defs/digest"},
    "standard":{"const":"EIGIIB-P1-A13-1.0"},
    "tool":{"const":"eigiib-p1-a13-revocation-check"},
    "tool_version":{"const":"0.1.0"},
    "trusted_effective_time_unix":{"const":1785603600},
    "vulnerability_remediation_result":{"const":"not-claimed"},
    "withdrawn_channel_ids":{"const":["fixture-primary","fixture-mirror"]}
  },
  "$defs":{"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}
}
