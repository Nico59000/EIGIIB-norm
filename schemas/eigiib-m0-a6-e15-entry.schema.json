        "rule": {"const": "historical-source-commit-readback-before-descendant-central-profile-mutation"},
        "silent_retargeting_forbidden": {"const": true},
        "transition_must_verify": {
          "items": {"type": "string"},
          "minItems": 7,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "rule",
        "frozen_source_commit",
        "historical_replay_mode",
        "current_tree_byte_equality_required_before_e15_a1",
        "descendant_transition_required",
        "silent_retargeting_forbidden",
        "transition_must_verify"
      ],
      "type": "object"
    },
    "decision_vocabulary": {"type": "object"},
    "entry_gate": {"type": "object"},
    "input_contract": {"type": "object"},
    "methodology_translation": {
      "additionalProperties": false,
      "properties": {
        "direct_source_republication": {"const": false},
        "mode": {"const": "typed-derived-rules-only"},
        "rules": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string"},
              "statement": {"type": "string"}
