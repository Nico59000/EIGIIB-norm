            "required": ["id", "statement"],
            "type": "object"
          },
          "maxItems": 7,
          "minItems": 7,
          "type": "array"
        },
        "source_equations_allowed": {"const": false},
        "source_specific_terminology_allowed": {"const": false},
        "source_status": {"const": "external-contextual-methodology-input"}
