{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "EIGIIB M0-A13 reopening request",
  "required": [
    "maintenanceEventId",
    "maintenanceClass",
    "reasonCode",
    "affectedPaths",
    "affectedClaims",
    "predecessorFreezeDigest",
    "maintenancePlanDigest",
    "rollbackPlanDigest",
    "issuedAt",
    "expiresAt",
    "requestDigest"
  ],
  "properties": {
    "maintenanceEventId": {
      "type": "string",
      "pattern": "^m0-maintenance-[0-9]{4,}$"
    },
    "maintenanceClass": {
      "enum": [
        "normative-correction",
        "security-emergency",
        "deprecation-or-withdrawal"
      ]
    },
    "reasonCode": {
      "type": "string",
      "minLength": 3
    },
    "affectedPaths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\.\\.)(?!.*[*?\\[]).+$"
      }
    },
    "affectedClaims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "predecessorFreezeDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "maintenancePlanDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rollbackPlanDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
