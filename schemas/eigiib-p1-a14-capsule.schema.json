{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://eigiib.example/schema/p1-a14-capsule-1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["standard","profile","sourceAuthority","remediationControlRoot","advisoryAuthority","remediationAuthority","fixedReleaseSigner","policy","advisory","remediation","fixedRelease","replays","claimBoundary"],
  "properties":{
    "standard":{"const":"EIGIIB-P1-A14-1.0"},
    "profile":{"const":"registered-advisory-remediation-fixed-release-v1"},
    "sourceAuthority":{"$ref":"#/$defs/source"},
    "remediationControlRoot":{"$ref":"#/$defs/key"},
    "advisoryAuthority":{"$ref":"#/$defs/authority"},
    "remediationAuthority":{"$ref":"#/$defs/authority"},
    "fixedReleaseSigner":{"$ref":"#/$defs/authority"},
    "policy":{"$ref":"#/$defs/signed"},
    "advisory":{"$ref":"#/$defs/signed"},
    "remediation":{"$ref":"#/$defs/signed"},
    "fixedRelease":{"$ref":"#/$defs/signed"},
    "replays":{"type":"array","minItems":5,"maxItems":5,"items":{"type":"object","additionalProperties":false,"required":["id","candidate","expectedDecision"],"properties":{"id":{"type":"string","minLength":1},"candidate":{"$ref":"#/$defs/signed"},"expectedDecision":{"enum":["accepted-idempotent-fixed-release-replay","rejected-revoked-predecessor","rejected-fixed-release-content-substitution","rejected-advisory-lineage-mismatch","rejected-below-fixed-release-floor"]}}}},
    "claimBoundary":{"type":"array","minItems":8,"maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  },
  "$defs":{
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "identity":{"type":"object","additionalProperties":false,"required":["algorithm","bytes","digest"],"properties":{"algorithm":{"const":"sha256"},"bytes":{"type":"integer","minimum":1},"digest":{"$ref":"#/$defs/digest"}}},
    "carrier":{"type":"object","additionalProperties":false,"required":["data","identity"],"properties":{"data":{"type":"string","minLength":1,"pattern":"^[A-Za-z0-9+/]+={0,2}$"},"identity":{"$ref":"#/$defs/identity"}}},
    "signed":{"type":"object","additionalProperties":false,"required":["payload","envelope"],"properties":{"payload":{"$ref":"#/$defs/carrier"},"envelope":{"$ref":"#/$defs/carrier"}}},
    "key":{"type":"object","additionalProperties":false,"required":["path","spki"],"properties":{"path":{"type":"string","pattern":"^[A-Za-z0-9._/-]+$"},"spki":{"$ref":"#/$defs/identity"}}},
    "authority":{"type":"object","additionalProperties":false,"required":["id","path","spki"],"properties":{"id":{"type":"string","minLength":1},"path":{"type":"string","pattern":"^[A-Za-z0-9._/-]+$"},"spki":{"$ref":"#/$defs/identity"}}},
    "source":{"type":"object","additionalProperties":false,"required":["acceptedHistory","archiveSha256","boundary","releaseDescriptorSha256","releaseId","revocationCapsuleSha256","revocationEnvelope","revocationId","revocationReportSha256","revocationSequence","sourceCommit","trustedEffectiveTimeUnix"],"properties":{"acceptedHistory":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"string"}},"archiveSha256":{"$ref":"#/$defs/digest"},"boundary":{"const":"registered-content-revocation-distribution-withdrawal-anti-rollback-closure"},"releaseDescriptorSha256":{"$ref":"#/$defs/digest"},"releaseId":{"const":"eigiib-p1-a7-authority-1.0"},"revocationCapsuleSha256":{"$ref":"#/$defs/digest"},"revocationEnvelope":{"$ref":"#/$defs/identity"},"revocationId":{"const":"eigiib-p1-a13-revocation-1"},"revocationReportSha256":{"$ref":"#/$defs/digest"},"revocationSequence":{"const":31},"sourceCommit":{"const":"077634971f2c16f3f74eb4c6c5b75aa7099bee55"},"trustedEffectiveTimeUnix":{"const":1785603600}}}
  }
