{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/eigiib-m0-a15-witness-endorsement.schema.json",
  "title": "EIGIIB M0 A15 Witness Endorsement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "witnessId",
    "controlDomainId",
    "recordDigest",
    "signedAt"
  ],
  "properties": {
    "witnessId": {
      "type": "string",
      "minLength": 1
    },
    "controlDomainId": {
      "type": "string",
      "minLength": 1
    },
    "recordDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
