{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schemas/e16-a5-verifier-matrix.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard",
    "status",
    "source_e16_a4_commit",
    "reference_verifier",
    "independent_verifier",
    "cases"
  ],
  "properties": {
    "standard": {
      "const": "EIGIIB-E16-A5-MATRIX-1.0"
    },
    "status": {
      "const": "frozen-vectors"
    },
    "reference_verifier": {
      "const": "tools/eigiib_e16_preservation_reference.py"
    },
    "independent_verifier": {
      "const": "tools/eigiib_e16_preservation_independent.py"
    },
    "cases": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "expected_state",
          "inputs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expected_state": {
            "enum": [
              "e16-preservation-closure-verified",
              "rejected",
              "held",
              "unavailable"
            ]
          },
          "inputs": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lineage_result",
              "a4_recovery_result",
              "content_identity_result",
              "verifier_independence_result",
              "route_coverage_result",
              "anti_rollback_result",
              "loss_result",
              "quarantine_result",
              "final_freeze_result",
              "expected_content_sha256",
              "accepted_generation",
              "restore_routes"
            ],
            "properties": {
              "lineage_result": {
                "enum": [
                  "current",
                  "stale",
                  "held",
                  "unavailable"
                ]
              },
              "a4_recovery_result": {
                "enum": [
                  "successor-replica-recovered",
                  "rejected",
                  "held",
                  "unavailable"
                ]
              },
              "content_identity_result": {
                "enum": [
                  "verified",
                  "rejected",
                  "held",
                  "unavailable"
                ]
              },
              "verifier_independence_result": {
                "enum": [
                  "independent",
                  "insufficient",
                  "held",
                  "unavailable"
                ]
              },
              "route_coverage_result": {
                "enum": [
                  "complete",
                  "incomplete",
                  "held",
                  "unavailable"
                ]
              },
              "anti_rollback_result": {
                "enum": [
                  "current",
                  "rollback-detected",
                  "held",
                  "unavailable"
                ]
              },
              "loss_result": {
                "enum": [
                  "clear",
                  "source-loss-contained",
                  "target-loss-confirmed",
                  "held",
                  "unavailable"
                ]
              },
              "quarantine_result": {
                "enum": [
                  "clear",
                  "source-quarantine-contained",
                  "target-quarantine-active",
                  "held",
                  "unavailable"
                ]
              },
              "final_freeze_result": {
                "enum": [
                  "conformant",
                  "non-conformant",
                  "held",
                  "unavailable"
                ]
              },
              "expected_content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "accepted_generation": {
                "type": "integer",
                "minimum": 0
              },
              "restore_routes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "verifier_domain",
                    "result",
                    "content_sha256",
                    "generation"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "verifier_domain": {
                      "type": "string",
                      "minLength": 1
                    },
                    "result": {
                      "enum": [
                        "verified",
                        "mismatch",
                        "held",
                        "unavailable"
                      ]
                    },
                    "content_sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "generation": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "source_e16_a4_commit": {
      "const": "b28fe74f829141232770155724620617bfb1241c"
    }
  }
}
