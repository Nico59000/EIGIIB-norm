  "input_contract": {
    "carrier_profile": "versioned carrier and transport representation accepted for the requested crossing",
    "delivery_policy": "versioned policy governing destination, purpose, action and required transport properties",
    "durability_policy": "versioned policy defining bounded persistence observations without claiming infinite retention",
    "e14_release_event": "exact E14-A5 released event admitted as the source crossing",
    "e14_release_receipt": "exact committed E14-A5 receipt bound to the released event",
    "endpoint_identity": "declared external endpoint or registry identity, distinct from recipient identity",
    "evaluation_context": "fixed purpose, operation, policy revisions and interpretation context",
    "external_attestation_policy": "trusted attester classes, signature requirements and evidence freshness rules",
    "idempotency_key": "operation key preventing silent duplicate delivery attempts",
    "recipient_scope": "named or typed relying-party scope, distinct from proof of possession or human awareness",
    "released_object_commitment": "exact artifact or projection commitment carried out of E14",
    "withdrawal_policy": "versioned rules for stopping future distribution, tombstoning and bounded post-withdrawal observation"
  },
  "methodology_translation": {
    "direct_source_republication": false,
    "mode": "typed-derived-rules-only",
    "rules": [
      {
        "id": "typed-transport-declaration",
        "statement": "a value changes role only through an explicit source type, target type, interpretation rule and context"
      },
      {
        "id": "role-separated-diagnostics",
        "statement": "binding, external attestation, acknowledgement, persistence and withdrawal remain independently evaluated coordinates"
      },
      {
        "id": "structural-before-lifecycle-interpretation",
        "statement": "lineage and commitment binding are established before any delivery or persistence state is interpreted"
      },
      {
        "id": "role-scoped-normalization",
        "statement": "thresholds and normalizations belong to one declared diagnostic role and cannot be silently reused by another"
      },
      {
        "id": "coincidence-is-not-identity",
        "statement": "equal values, identifiers or digests do not collapse distinct authority roles without an explicit typed map"
      },
      {
        "id": "local-evidence-is-not-global-state",
        "statement": "one endpoint observation cannot establish global delivery, durability, withdrawal or erasure"
      },
      {
        "id": "declared-composite-policy",
        "statement": "no universal weighted aggregate is assumed; any composite decision policy must declare its coefficients and precedence"
      }
    ],
    "source_equations_allowed": false,
    "source_specific_terminology_allowed": false,
    "source_status": "external-contextual-methodology-input"
  },
