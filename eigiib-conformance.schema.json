{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigiib.example/schema/eigiib-conformance.schema.json",
  "title": "EIGIIB-E2 Repository Conformance Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "tool_version",
    "standard",
    "target",
    "revision",
    "mechanical_result",
    "manual_result",
    "overall_result",
    "findings"
  ],
  "properties": {
    "tool": {"const": "eigiib-check"},
    "tool_version": {"type": "string", "minLength": 1},
    "standard": {"const": "EIGIIB-1.0+E1-1.0+E2-1.0"},
    "target": {
      "enum": ["EIGIIB-C1", "EIGIIB-C2", "EIGIIB-C3", "unknown"]
    },
    "revision": {"type": "string", "minLength": 1},
    "mechanical_result": {
      "enum": ["conformant", "non-conformant", "unavailable"]
    },
    "manual_result": {
      "enum": ["complete", "pending", "not-applicable"]
    },
    "overall_result": {
      "enum": [
        "conformant",
        "conformant-with-documented-deviations",
        "non-conformant",
        "partially-evaluated",
        "not-evaluated",
        "unavailable"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "path", "message"],
        "properties": {
          "severity": {"enum": ["error", "warning", "info"]},
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]{1,127}$"
          },
          "path": {"type": "string"},
          "message": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
